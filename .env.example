# Port the server listens on
PORT=8080
# The address phones should open (printed as QR code). Use your public HTTPS URL in production.
PUBLIC_URL=https://jezisek.example.com/
# Optional PIN protecting /host and the screen controls (recommended on a public URL)
HOST_PIN=2412
# Only needed to (re)generate voices: npm run voices
XAI_API_KEY=
