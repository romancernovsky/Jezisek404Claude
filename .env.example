# Copy to .env (docker compose reads it automatically).
# Host port for local Docker
PORT=8080
# Address phones open (shown as QR code). Leave empty to use the address the screen is opened with.
# Local test with phones on Wi-Fi: http://192.168.1.23:8080/   Production: https://<your Cloud Run or custom domain>/
PUBLIC_URL=
# PIN for /host and the screen controls. Strongly recommended on any public URL.
HOST_PIN=
# Only for regenerating voices (npm run voices). Never needed at runtime.
XAI_API_KEY=
